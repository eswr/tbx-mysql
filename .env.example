# Database
ARTHA_DATABASE_URL=mysql://artha:artha@127.0.0.1:3306/artha
ARTHA_MYSQL_SESSION_TZ=+05:30

# Debit sign convention: "positive" (schema default) or "negative" (for data with -debits)
ARTHA_DEBIT_SIGN=positive

# UTR search mode: "plaintext" or "opaque" (if encrypted/unsearchable)
ARTHA_UTR_MODE=plaintext

# LLM provider: "rules", "ollama", empty for auto
ARTHA_LLM_PROVIDER=rules

# Ollama
ARTHA_OLLAMA_BASE_URL=http://127.0.0.1:11434
ARTHA_OLLAMA_MODEL=qwen3.5:0.8b

# Conversation store: "sqlite" or "memory"
ARTHA_CONVERSATION_STORE=sqlite
ARTHA_SQLITE_DB_PATH=./backend/artha.db

# CORS
ARTHA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
ARTHA_LOG_LEVEL=INFO
